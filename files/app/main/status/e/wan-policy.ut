{%
const supportedBoards = {
    "mikrotik,routerboard-952ui-5ac2nd": true,
    "mikrotik,hap-ac2": true,
    "mikrotik,hap-ac3": true
};
if (!auth.isAdmin) { response.statusCode = 403; print("Administrator authentication required"); return; }
if (!supportedBoards[hardware.getBoardModel().id]) { response.statusCode = 404; print("PollyWAN is not available on this device"); return; }

function allowed(value, values, fallback)
{
    for (let i = 0; i < length(values); i++) if (value === values[i]) return value;
    return fallback;
}
function bounded(value, fallback, minimum, maximum)
{
    const n = int(value || fallback);
    return n >= minimum && n <= maximum ? n : fallback;
}
function validHttpsUrl(value, required)
{
    if (!value) return !required;
    if (substr(value, 0, 8) !== "https://") return false;
    if (index(value, " ") >= 0 || index(value, "@") >= 0 || index(value, "#") >= 0) return false;
    const rest = substr(value, 8);
    const slash = index(rest, "/");
    if (slash <= 0) return false;
    const host = substr(rest, 0, slash);
    return host && index(host, ":") < 0 && index(host, "..") < 0;
}
function requestedValue(name, fallback)
{
    return request.args[name] != null ? request.args[name] : fallback;
}
function routeLabel(value)
{
    return value === "wan" ? "WAN 1" : value === "wan2" ? "WAN 2" : value === "wan3" ? "Android USB tether" : value === "mesh" ? "Remote Mesh WAN" : "Unknown route";
}
function readJson(path)
{
    const value = fs.readfile(path);
    if (!value) return null;
    try { return json(value); } catch (_) { return null; }
}
function wifiWanInfo()
{
    const radio0 = uciMesh.get("setup", "globals", "radio0_mode") || "";
    const radio1 = uciMesh.get("setup", "globals", "radio1_mode") || "";
    if (radio0 === "wan" && radio1 === "wan") return { active: false, conflict: true, device: "", label: "invalid: both radios" };
    if (radio0 === "wan") return { active: true, conflict: false, device: "wlan0", label: "Wi-Fi wlan0" };
    if (radio1 === "wan") return { active: true, conflict: false, device: "wlan1", label: "Wi-Fi wlan1" };
    return { active: false, conflict: false, device: "br-wan", label: "Ethernet" };
}

const wifiWan = wifiWanInfo();
let message = "";
let error = "";
if (request.env.REQUEST_METHOD === "PUT") {
    const action = request.args.action || "save";
    if (action === "save") {
        const enabled = request.args.enabled === "on" ? "1" : "0";
        const minbin = allowed(request.args.selection_min_bin || "low", [ "low", "medium", "fast" ], "low");
        const sharebin = allowed(request.args.mesh_share_min_bin || "medium", [ "low", "medium", "fast" ], "medium");
        const health = bounded(request.args.health_interval, 30, 10, 3600);
        const failures = bounded(request.args.failure_count, 2, 1, 10);
        const promotions = bounded(request.args.promote_count, 2, 1, 10);
        const hold = bounded(request.args.hold_down, 120, 0, 3600);
        const exportRecover = bounded(request.args.mesh_export_recover_count, 3, 1, 10);
        const exportHold = bounded(request.args.mesh_export_hold_down, 60, 0, 3600);
        const primaryUrl = requestedValue("health_url", uciMesh.get("aredn", "multiwan", "health_url") || "https://connectivitycheck.gstatic.com/generate_204");
        const secondaryUrl = requestedValue("health_url_secondary", uciMesh.get("aredn", "multiwan", "health_url_secondary") || "");
        const priorities = [];
        const seen = {};
        let duplicatePriority = false;
        for (let i = 1; i <= 4; i++) {
            const route = allowed(request.args[`priority_${i}`] || "", [ "wan", "wan2", "wan3", "mesh" ], "");
            if (!route || seen[route]) duplicatePriority = true;
            else seen[route] = true;
            push(priorities, route);
        }
        const wanEnabled = request.args.wan_enable === "on";
        const wan2Enabled = request.args.wan2_enable === "on";
        const wan3Enabled = request.args.wan3_enable === "on";
        const meshEnabled = request.args.mesh_enable === "on";

        if (enabled === "1" && wifiWan.conflict) {
            error = "Both AREDN radios are configured as WAN clients. Only one radio may own logical WAN 1.";
        }
        else if (duplicatePriority) error = "Each route must appear exactly once in the preferred connection order.";
        else if (enabled === "1" && !wanEnabled && !wan2Enabled && !wan3Enabled && !meshEnabled) error = "Enable at least one route before enabling PollyWAN.";
        else if (!validHttpsUrl(primaryUrl, true)) error = "Primary probe endpoint must be an HTTPS URL with a host and path.";
        else if (!validHttpsUrl(secondaryUrl, false)) error = "Secondary probe endpoint must be empty or an HTTPS URL with a host and path.";
        else if (int(request.args.mesh_export_recover_count || 3) < 1 || int(request.args.mesh_export_recover_count || 3) > 10) error = "Export recovery observations must be between 1 and 10.";
        else if (int(request.args.mesh_export_hold_down || 60) < 0 || int(request.args.mesh_export_hold_down || 60) > 3600) error = "Export recovery hold-down must be between 0 and 3600 seconds.";
        else {
        let writeOk = true;
        try {
        uciMesh.set("aredn", "multiwan", "multiwan");
        uciMesh.set("aredn", "multiwan", "enabled", enabled);
        uciMesh.set("aredn", "multiwan", "selection_mode", "ordered");
        uciMesh.set("aredn", "multiwan", "preferred_wan", priorities[0]);
        uciMesh.set("aredn", "multiwan", "wan_enable", wanEnabled ? "1" : "0");
        uciMesh.set("aredn", "multiwan", "wan2_enable", wan2Enabled ? "1" : "0");
        uciMesh.set("aredn", "multiwan", "wan3_enable", wan3Enabled ? "1" : "0");
        uciMesh.set("aredn", "multiwan", "mesh_enable", meshEnabled ? "1" : "0");
        for (let i = 0; i < 4; i++) uciMesh.set("aredn", "multiwan", `priority_${i + 1}`, priorities[i]);
        uciMesh.set("aredn", "multiwan", "selection_min_bin", minbin);
        uciMesh.set("aredn", "multiwan", "mesh_share_min_bin", sharebin);
        uciMesh.set("aredn", "multiwan", "health_interval", health);
        uciMesh.set("aredn", "multiwan", "health_url", primaryUrl);
        uciMesh.set("aredn", "multiwan", "health_url_secondary", secondaryUrl);
        uciMesh.set("aredn", "multiwan", "failure_count", failures);
        uciMesh.set("aredn", "multiwan", "promote_count", promotions);
        uciMesh.set("aredn", "multiwan", "hold_down", hold);
        uciMesh.set("aredn", "multiwan", "mesh_export_recover_count", exportRecover);
        uciMesh.set("aredn", "multiwan", "mesh_export_hold_down", exportHold);
        uciMesh.set("aredn", "multiwan", "return_to_preferred", "1");
        uciMesh.set("aredn", "@wan[0]", "mesh_to_local_wan", request.args.mesh_to_local_wan === "on" ? "1" : "0");
        uciMesh.set("aredn", "@wan[0]", "lan_to_remote_wan", meshEnabled ? "1" : "0");
        if (uciMesh.commit("aredn") === false) writeOk = false;
        } catch (_) { writeOk = false; }

        if (!writeOk) error = "Route policy could not be saved to persistent AREDN configuration.";
        else if (enabled === "1") {
            system("rm -f /tmp/wan-sla/inhibit; /etc/init.d/wan3-manager restart >/dev/null 2>&1 &");
            message = "PollyWAN policy saved and controller restarted";
        }
        else {
            system("mkdir -p /tmp/wan-sla; touch /tmp/wan-sla/inhibit; /usr/local/bin/wan-port-manager disable >/dev/null 2>&1; /usr/local/bin/wan3-manager disable >/dev/null 2>&1; /usr/local/bin/wan-tunnel-guard remove >/dev/null 2>&1; /etc/init.d/wan3-manager stop >/dev/null 2>&1 &");
            message = "PollyWAN disabled; managed port roles and package-created routing are being removed";
        }
        }
    }
    else if (action === "evaluate") {
        system("/usr/local/bin/wan-sla once >/dev/null 2>&1 &");
        message = "A fresh WAN evaluation was requested";
    }
    else error = "Invalid policy action";
}

const enabled = uciMesh.get("aredn", "multiwan", "enabled") === "1";
const active = uciMesh.get("aredn", "multiwan", "active") || "wan";
const status = readJson("/tmp/wan-sla/status.json");
const candidates = status && status.candidates || [];
const routeChoices = [
    { value: "wan", label: `WAN 1 (${wifiWan.label})` },
    { value: "wan2", label: "WAN 2" },
    { value: "wan3", label: "Android USB tether" },
    { value: "mesh", label: "Remote Mesh WAN" }
];
const priorities = [];
for (let i = 1; i <= 4; i++) push(priorities, uciMesh.get("aredn", "multiwan", `priority_${i}`) || routeChoices[i - 1].value);
%}
<div class="dialog pollywan-dialog">
    {{_R("dialog-header", "Route Policy Setup")}}
    <div>
        {% if (error) { %}<div class="pw-notice pw-notice-error"><b>{{error}}</b></div>{% } else if (message) { %}<div class="pw-notice pw-notice-ok">{{message}}</div>{% } %}
        <div class="cols"><div><div class="o">Runtime decision</div><div class="m">{{status && status.message || "No SLA status is available"}}</div></div><div style="flex:0;text-align:right"><div>{{status && status.active || active}}</div><div class="m">{{status && status.selected_bin || "unknown"}}</div></div></div>
        <div class="cols"><div><div class="o">WAN 1 transport</div><div class="m">AREDN Wi-Fi client mode still uses logical interface wan and private table 101</div></div><div style="flex:0;text-align:right"><div>{{wifiWan.label}}</div><div class="m">{{wifiWan.active ? wifiWan.device : "br-wan"}}</div></div></div>
        <form id="wan-policy-form">
            <div class="cols"><div><div class="o">Enable PollyWAN</div><div class="m">Disabled installation is inert and leaves ordinary AREDN networking and GPS untouched</div></div><div style="flex:0"><input type="checkbox" name="enabled" {{enabled ? "checked" : ""}}></div></div>
            <div class="cols"><div><div class="o">Enabled routes</div><div class="m">Only checked routes can be selected. Remote Mesh WAN uses an AREDN/Babel default from table 22.</div></div><div style="flex:0;white-space:nowrap"><label>WAN 1 <input type="checkbox" name="wan_enable" {{uciMesh.get("aredn", "multiwan", "wan_enable") !== "0" ? "checked" : ""}}></label> <label>WAN 2 <input type="checkbox" name="wan2_enable" {{uciMesh.get("aredn", "multiwan", "wan2_enable") === "1" ? "checked" : ""}}></label> <label>USB <input type="checkbox" name="wan3_enable" {{uciMesh.get("aredn", "multiwan", "wan3_enable") === "1" ? "checked" : ""}}></label> <label>Remote Mesh WAN <input type="checkbox" name="mesh_enable" {{uciMesh.get("aredn", "multiwan", "mesh_enable") === "1" ? "checked" : ""}}></label></div></div>
            <div class="cols"><div><div class="o">Preferred connection order</div><div class="m">Use choice 1 whenever it is eligible. If it fails, use choice 2, then 3, then 4. Return upward only after the higher-priority route passes the recovery checks.</div></div><div class="pw-field">{% const orderLabels = [ "1 — use first", "2 — if 1 fails", "3 — if 1 and 2 fail", "4 — last resort" ]; for (let i = 0; i < 4; i++) { %}<label>{{orderLabels[i]}}<select name="priority_{{i + 1}}">{% for (let j = 0; j < length(routeChoices); j++) { const choice = routeChoices[j]; %}<option value="{{choice.value}}" {{priorities[i] === choice.value ? "selected" : ""}}>{{choice.label}}</option>{% } %}</select></label>{% } %}</div></div>
            <div class="cols"><div><div class="o">Minimum allowable local data rate</div><div class="m">Affects WAN 1, WAN 2, and USB after a speed result exists. Remote Mesh WAN is judged by route availability. Higher settings require a current speed test.</div></div><div class="pw-field"><select name="selection_min_bin"><option value="low" {{uciMesh.get("aredn", "multiwan", "selection_min_bin") === "low" ? "selected" : ""}}>Any healthy local route</option><option value="medium" {{uciMesh.get("aredn", "multiwan", "selection_min_bin") === "medium" ? "selected" : ""}}>At least 5 Mbps</option><option value="fast" {{uciMesh.get("aredn", "multiwan", "selection_min_bin") === "fast" ? "selected" : ""}}>At least 30 Mbps</option></select></div></div>
            <div class="cols"><div><div class="o">Offer selected local Internet route to the mesh</div><div class="m">Publishes table 28 only while the selected local route is healthy and meets the sharing data-rate floor.</div></div><div style="flex:0"><input type="checkbox" name="mesh_to_local_wan" {{uciMesh.get("aredn", "@wan[0]", "mesh_to_local_wan") === "1" ? "checked" : ""}}></div></div>
            <div class="cols"><div><div class="o">Minimum local data rate offered to mesh users</div><div class="m">This does not affect local failover; it only controls whether the selected local route is advertised to other mesh nodes.</div></div><div class="pw-field"><select name="mesh_share_min_bin"><option value="low" {{uciMesh.get("aredn", "multiwan", "mesh_share_min_bin") === "low" ? "selected" : ""}}>Any measured rate</option><option value="medium" {{uciMesh.get("aredn", "multiwan", "mesh_share_min_bin") === "medium" ? "selected" : ""}}>At least 5 Mbps</option><option value="fast" {{uciMesh.get("aredn", "multiwan", "mesh_share_min_bin") === "fast" ? "selected" : ""}}>At least 30 Mbps</option></select></div></div>
            <div class="cols"><div><div class="o">Internet health checks</div><div class="m">Check each active route every N seconds and fail over after N consecutive failures. Remote Mesh WAN availability comes from table 22.</div></div><div style="flex:0;white-space:nowrap"><input name="health_interval" type="number" min="10" max="3600" size="5" value="{{uciMesh.get("aredn", "multiwan", "health_interval") || 30}}"> seconds / <input name="failure_count" type="number" min="1" max="10" size="3" value="{{uciMesh.get("aredn", "multiwan", "failure_count") || 2}}"> failures</div></div>
            <div class="cols"><div><div class="o">Internet check URL</div><div class="m">HTTPS endpoint tested directly through each local route. Response-code handling is automatic.</div></div><div class="pw-field"><input name="health_url" type="url" pattern="https://.*" value="{{uciMesh.get("aredn", "multiwan", "health_url") || "https://connectivitycheck.gstatic.com/generate_204"}}"></div></div>
            <div class="cols"><div><div class="o">Backup Internet check URL</div><div class="m">Optional HTTPS endpoint used only when the primary check fails. Leave blank to disable it.</div></div><div class="pw-field"><input name="health_url_secondary" type="url" pattern="|https://.*" value="{{uciMesh.get("aredn", "multiwan", "health_url_secondary") || ""}}"></div></div>
            <div class="cols"><div><div class="o">Return to a recovered higher-priority route</div><div class="m">Require N successful observations and wait at least N seconds after the last switch. This produces A → B → C failover and returns C → B → A as routes recover.</div></div><div style="flex:0;white-space:nowrap"><input name="promote_count" type="number" min="1" max="10" size="3" value="{{uciMesh.get("aredn", "multiwan", "promote_count") || 2}}"> successes / <input name="hold_down" type="number" min="0" max="3600" size="5" value="{{uciMesh.get("aredn", "multiwan", "hold_down") || 120}}"> seconds</div></div>
            <div class="cols"><div><div class="o">Resume offering a recovered route to the mesh</div><div class="m">Require N successful observations and N seconds before republishing table 28 after an outage.</div></div><div style="flex:0;white-space:nowrap"><input name="mesh_export_recover_count" type="number" min="1" max="10" size="3" value="{{uciMesh.get("aredn", "multiwan", "mesh_export_recover_count") || 3}}"> successes / <input name="mesh_export_hold_down" type="number" min="0" max="3600" size="5" value="{{uciMesh.get("aredn", "multiwan", "mesh_export_hold_down") || 60}}"> seconds</div></div>
        </form>
        <div class="pw-actions pw-policy-actions"><button type="button" hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-include="#wan-policy-form" hx-vals='{"action":"save"}'>Save and apply policy</button><button type="button" hx-put="{{request.env.REQUEST_URI}}" hx-target="#ctrl-modal" hx-swap="innerHTML" hx-vals='{"action":"evaluate"}'>Evaluate now</button></div>
        <div class="pw-notice">Use <b>Save and apply policy</b> to activate these settings. <b>Done</b> only closes this window and does not save or apply changes.</div>
        {{_H("The configured connection order is authoritative: speed never reorders routes. A local route must pass its source-bound HTTPS health check and the minimum data-rate policy. Remote Mesh WAN is eligible only when enabled and an AREDN/Babel default exists in table 22. Failover to the next eligible route is immediate after the failure threshold; returning to a recovered higher-priority route uses the configured success count and hold-down. A remote default is never copied into table 28.")}}
        {% if (length(candidates)) { %}<hr><div class="cols">{% for (let i = 0; i < length(candidates); i++) { const c = candidates[i]; %}<div><div class="t">{{routeLabel(c.name)}} — {{c.configured ? (c.selection_healthy ? "Eligible" : "Unavailable") : "Disabled"}}</div><div class="s">{{c.name === "mesh" ? "Exit node " + (status && status.remote_mesh_exit_node || "unknown") : (c.mbps ? sprintf("%.1f Mbps", c.mbps) : "Data rate not measured")}} &middot; {{c.probe_reason || c.reason}}</div></div>{% } %}</div>{% } %}
    </div>
    {{_R("dialog-footer", "nocancel")}}
    <script>(function(){ {{_R("open")}} htmx.on("#dialog-done", "click", _ => htmx.ajax("GET", "/a/u-wan-policy", { target: "#wan-policy", swap: "outerHTML" })); })();</script>
</div>
